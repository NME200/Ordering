# ============================================================
# 后端服务环境变量模板（.env.example）
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交。
# 技术栈：NestJS + TypeORM + MySQL + Redis
# ============================================================

# ---------------------- 应用配置 ----------------------
# 运行环境：development / production / test
NODE_ENV=development
# 服务监听端口
# 本地开发注意：若 3000 被占用（如 WSL 内服务经 wslrelay 转发），可改为 3100 等空闲端口
PORT=3100
# 接口全局路由前缀（在 main.ts 中通过 setGlobalPrefix 使用）
API_PREFIX=/api/v1

# ---------------------- MySQL 配置 ----------------------
# 数据库主机地址（本地开发为 localhost）
DB_HOST=localhost
# 数据库端口（MySQL 默认 3306）
DB_PORT=3306
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=your_mysql_password
# 数据库名称（开发库）
# 必须全小写：Windows 下 MySQL 的 lower_case_table_names=1 会把库名强制转成小写，
# 而 TypeORM 用配置值去 information_schema 查表存在性，大小写不一致会误判「表不存在」。
DB_NAME=ordering-dev
# 是否自动同步实体到表结构：开发环境可 true，生产环境必须 false（改用 migration）
DB_SYNCHRONIZE=true
# 是否打印 SQL 日志：开发调试可 true
DB_LOGGING=false
# 连接池大小（可选）
DB_POOL_SIZE=10

# ---------------------- Redis 配置 ----------------------
# Redis 主机地址（本地开发为 localhost）
REDIS_HOST=localhost
# Redis 端口（默认 6379）
REDIS_PORT=6379
# Redis 密码（无密码则留空）
REDIS_PASSWORD=your_redis_password
# Redis 逻辑库编号（默认 0）
REDIS_DB=0

# ---------------------- JWT 配置 ----------------------
# JWT 签名密钥（生产环境务必使用强随机值，切勿使用示例值）
JWT_SECRET=your_jwt_secret
# Token 有效期（如 7d、2h）
JWT_EXPIRES_IN=7d

# ---------------------- 跨域（CORS）配置 ----------------------
# 是否启用 CORS 校验
CORS_ENABLED=true
# 允许访问后端的域名 / IP 白名单，多个用英文逗号分隔（支持带协议与端口）
# ⚠️ 禁止使用 * ；生产环境必须改为真实前端域名（如 https://admin.example.com）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# 是否允许携带凭证（Cookie / Authorization）；为 true 时 CORS_ORIGINS 绝不能为 *
CORS_CREDENTIALS=true
# 预检请求缓存时间（秒）
CORS_MAX_AGE=86400

# ---------------------- 敏感配置主密钥 ----------------------
# 用于加解密入库的支付渠道凭据（支付宝应用私钥、微信商户私钥 / APIv3 密钥等）。
# 这不是支付配置本身，只是保护支付配置的那把钥匙。
#
# 支付渠道的商户号、密钥、证书等**全部改在「平台管理端 → 支付配置」里填写**，
# 存进数据库 payment_configs 表（密文），不再放这里 —— 运营可以自助维护，
# 改完同进程热生效，不用重启、也不用重新发版。
#
# ⚠️ 换掉本值会让已入库的支付配置全部无法解密，必须重新在界面上填写一遍。
# ⚠️ 生产环境务必换成全新的强随机值（≥32 字符），且不与任何其它密钥复用。
CONFIG_SECRET_KEY=replace_with_a_strong_random_master_key_at_least_16_chars
